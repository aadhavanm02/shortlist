{
	"appId": "io.github.aadhavanm02.shortlist",
	"appName": "Shortlist",
	"webDir": "dist",
	"android": {
		"backgroundColor": "#FAF8F6"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 800,
			"launchAutoHide": true,
			"backgroundColor": "#FAF8F6",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#FAF8F6",
			"overlaysWebView": false
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_shortlist",
			"iconColor": "#F06434"
		}
	}
}
